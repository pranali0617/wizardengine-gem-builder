{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/wizards/save",
      "dest": "/api/wizards-save"
    },
    {
      "src": "/api/prompt/refine",
      "dest": "/api/prompt-refine"
    },
    {
      "src": "/api/knowledge/upload",
      "dest": "/api/knowledge-upload"
    },
    {
      "src": "/api/wizards",
      "dest": "/api/wizards"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
